VRCX_WEB_IMAGE=ghcr.io/e-larex/vrcx-docker:latest
# Pin a release or roll back with a tag such as 2.32.0-web.1.
VRCX_WEB_ORIGIN=https://vrcx.example.com
# LAN HTTP: set this to 1 and VRCX_WEB_LISTEN to 0.0.0.0; ORIGIN is ignored.
VRCX_WEB_LAN_MODE=0
# Plaintext password (at least 12 characters), or a complete Argon2id v19 PHC hash.
# Generate hashes with an external tool; the salt and parameters are part of the hash.
# Quote hashes with single quotes to preserve $: VRCX_WEB_PASSWORD='$argon2id$...'
# The $argon2 prefix is reserved for hashes; malformed hashes prevent startup.
# VRCX_WEB_PASSWORD_FILE is no longer supported; remove it from your environment.
# Only LAN mode permits an empty password, which disables website login.
VRCX_WEB_PASSWORD=
VRCX_WEB_LISTEN=127.0.0.1
VRCX_WEB_PORT=8080
TZ=Asia/Shanghai
