VRCX_WEB_IMAGE=ghcr.io/e-larex/vrcx-docker:latest
# Pin a release or roll back with a tag such as 2.32.0-web.1.
VRCX_WEB_ORIGIN=https://vrcx.example.com
# LAN HTTP: set this to 1 and VRCX_WEB_LISTEN to 0.0.0.0; ORIGIN is ignored.
VRCX_WEB_LAN_MODE=0
# Use a unique password with at least 12 characters.
# Only LAN mode permits an empty password, which disables website login.
VRCX_WEB_PASSWORD=
VRCX_WEB_LISTEN=127.0.0.1
VRCX_WEB_PORT=8080
TZ=Asia/Shanghai
